# W-Light — root .env.example (汇总全部变量)
#
# Copy to .env and fill in before deploying; do NOT commit the real .env.
#   cp .env.example .env
#   chmod 600 .env
#
# Sources (no variables invented here — every entry below appears in at least one of):
#   - docker-compose.yml
#   - scripts/server-deploy.sh  (ensure_env(): generates random secrets when missing)
#   - services/backend/.env.development.example
#   - services/backend/src/main.ts, src/config/database.config.ts,
#     src/database/data-source.ts, src/database/seeds/run-seeds.ts
#
# Secrets: server-deploy.sh auto-generates DB_PASSWORD / REDIS_PASSWORD /
# JWT_SECRET / MINIO_PASSWORD with random values when they are absent from .env.
# The backend refuses to start in production with a short or well-known secret
# (see services/backend/src/main.ts assertProductionSecrets).
# Never leave the example placeholder values below in a real deployment.

# --- Web / deployment ---
# Public web port (docker-compose maps ${WEB_PORT:-3005}:80).
WEB_PORT=3005
# Timezone used by all containers.
TZ=Asia/Shanghai
# Node heap cap passed to the API container (server-deploy.sh default).
NODE_OPTIONS=--max-old-space-size=384

# --- Backend API ---
NODE_ENV=production
# API listen port inside the container (fixed to 3000 in docker-compose.yml).
API_PORT=3000
# CORS allowlist, comma-separated. server-deploy.sh defaults it to
# http://<server-ip>, http://<server-ip>:<WEB_PORT>, wlight://app.
# APP_ORIGIN is the singular alias read by the backend; prefer APP_ORIGINS.
APP_ORIGINS=
APP_ORIGIN=
# Enable Swagger docs (backend also enables them automatically outside production).
ENABLE_SWAGGER=false
# Timezone used when generating order numbers.
ORDER_NO_TIME_ZONE=Asia/Shanghai

# --- Auth ---
# JWT signing secret. REQUIRED in production, at least 16 characters.
# Leave empty here only if you let server-deploy.sh generate it.
JWT_SECRET=
# JWT lifetime (e.g. 7d).
JWT_EXPIRES_IN=7d

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lightops
DB_USER=lightops
# REQUIRED in production; generated randomly by server-deploy.sh when absent.
DB_PASSWORD=
# TypeORM: never true in production (docker-compose forces false).
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_SSL=false
DB_LOGGING=false
# Postgres tuning (docker-compose defaults).
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=128MB

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED in production; generated randomly by server-deploy.sh when absent.
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=lightopsadmin
# REQUIRED in production; generated randomly by server-deploy.sh when absent.
# Must not be the well-known default 'minioadmin' (backend rejects it).
MINIO_PASSWORD=
MINIO_BUCKET=lightops-files

# --- RedisInsight (optional, `tools` profile only) ---
REDIS_INSIGHT_BIND=127.0.0.1
REDIS_INSIGHT_PORT=5540

# --- Seed admin (first admin user, created by run-seeds.ts) ---
# Phone used as the admin login account.
SEED_ADMIN_PHONE=13800000001
# Set one of these to choose the initial admin password; if neither is set a
# random one-time password is generated and printed once by the seed script.
SEED_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD=

# --- Local development only (SQLite, see services/backend/.env.development.example) ---
# The deployed stack uses Postgres (DB_TYPE=postgres in docker-compose.yml).
# These apply only when running the backend locally without Docker.
DB_TYPE=sqlite
DB_DATABASE=lightops.sqlite

# --- Deploy script options (environment, not .env — see scripts/server-deploy.sh) ---
# REPO_URL: git repository to deploy (default https://github.com/tony-wang1990/W-Light.git)
# BRANCH: git branch to deploy (default main)
# APP_DIR: install directory (default /root/W-Light for root, ~/W-Light otherwise)
# SWAP_SIZE: swap file size created on 1C1G hosts (default 2G; 0 / --no-swap to skip)
