NODE_ENV=development
API_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lightops
DB_USER=lightops
DB_PASSWORD=lightops_dev_pwd

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pwd

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production_must_be_at_least_64_chars_long_ok
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=lightops-files

# Firebase FCM (填入你的 Firebase 项目配置)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
