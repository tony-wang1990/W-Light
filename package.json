{
  "name": "lightops",
  "version": "0.9.0-internal.0",
  "description": "文旅灯光运维一体化 APP - Monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start:web": "corepack pnpm --filter web run dev",
    "start:mobile": "corepack pnpm --filter LightOps run start",
    "android": "corepack pnpm --filter LightOps run android",
    "android:release": "bash scripts/android-release.sh",
    "android:release:publish": "bash scripts/android-release.sh --publish-web",
    "ios:release": "bash scripts/ios-release.sh",
    "ios:release:publish": "bash scripts/ios-release.sh --publish-web",
    "desktop:dist": "corepack pnpm --filter desktop run prepare:web",
    "desktop:dist:win": "powershell -ExecutionPolicy Bypass -File scripts/desktop-release.ps1 -Target win",
    "desktop:dist:mac": "bash scripts/desktop-release.sh --mac",
    "desktop:dist:linux": "bash scripts/desktop-release.sh --linux",
    "desktop:release": "bash scripts/desktop-release.sh",
    "downloads:verify": "node scripts/verify-downloads.mjs",
    "ios": "corepack pnpm --filter LightOps run ios",
    "start:backend": "corepack pnpm --filter backend run start:dev",
    "build:toolbox-core": "corepack pnpm --filter @lightops/toolbox-core run build",
    "test:toolbox-core": "corepack pnpm --filter @lightops/toolbox-core run test",
    "build:backend": "corepack pnpm --filter backend run build",
    "build:web": "corepack pnpm --filter web run build",
    "build": "corepack pnpm run build:toolbox-core && corepack pnpm run build:backend && corepack pnpm run build:web",
    "start:prod": "corepack pnpm --filter backend run start",
    "test": "corepack pnpm -r run test",
    "lint": "corepack pnpm -r run lint",
    "format": "corepack pnpm -r run format",
    "db:migrate": "corepack pnpm --filter backend run migration:run",
    "db:seed": "corepack pnpm --filter backend run seed:run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "esbuild": "0.21.5"
  }
}
